uniform highp float overlay_strength;

void fragment() {
    highp vec4 sprite = zTexture(UV);

    if (sprite.a == 0.0) {
        discard;
    }

    sprite.a *= clamp(overlay_strength, 0.0, 1.0);
    COLOR = sprite * VtxModulate;
}
